APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/CRM/public
APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crm_db
DB_USER=root
DB_PASS=

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@crm.local"
MAIL_FROM_NAME="CRM Portal"

SESSION_LIFETIME=120
# Session handler: files (default), database, redis
SESSION_DRIVER=files

ADMIN_EMAIL=xxxxxxxxxxxxxx
ADMIN_PASSWORD=xxxxxxxxxxxxxx

RATE_LIMIT_DRIVER=database
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# File Storage: local (default), s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_KEY=
# S3_SECRET=
# S3_ENDPOINT=               # For R2/MinIO: https://acct-id.r2.cloudflarestorage.com
# S3_PREFIX=uploads

# Read Replica (optional; leave empty to use primary for all queries)
# DB_READ_HOST=
# DB_READ_PORT=3306
# DB_READ_USER=
# DB_READ_PASS=

# Cloudflare Turnstile (disabled by default for local development)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry Error Tracking (optional; leave empty to disable)
SENTRY_DSN=

# ==============================================================================
# Phase 9: Omnichannel Messaging Providers (Credentials loaded ONLY from .env)
# If credentials are not configured, provider is disabled and UI explicitly shows it.
# ==============================================================================

# WhatsApp Provider (Meta WhatsApp Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0

# SMS Provider (Indian DLT-Compliant SMS Gateway, e.g. MSG91)
SMS_GATEWAY=msg91
SMS_AUTH_KEY=
SMS_SENDER_ID=
SMS_DLT_TE_ID=
SMS_ROUTE=4
# SMS_GATEWAY_URL=              # Optional: Custom DLT gateway HTTP API URL

# Messaging Queue Rate Limiting
MESSAGE_RATE_LIMIT_PER_MINUTE=60

