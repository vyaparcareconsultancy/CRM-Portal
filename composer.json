{
    "name": "crm/portal",
    "description": "CRM portal for managing clients",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11"
    },
    "suggest": {
        "aws/aws-sdk-php": "Required to use S3/R2 storage driver (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run_all.php",
        "test:unit": "php tests/run_tests.php",
        "test:phpunit": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-text",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
        "test:e2e": "npx playwright test"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
